# pdxterm -- paideia-as build manifest
#
# Wave: R102  Milestone: M1 (#1, #2) + M2 (#3, #4, #5) [Wave OO] on top
# of the previously-landed M3 (ANSI parser) + M4 (three smokes) +
# v1.1-B (semantic pipe).
# Doc:  design/graphics/r102-user-plan.md §4.6 in the paideia-os repo.
#
# Wave OO landing shape: fills in the M1/M2 surface that Wave P's
# skeletons deferred -- argv-driven window geometry + KIND_SURFACE
# request stub (src/window.pdx, #2), a grid_put_char/grid_clear/
# grid_render_all cell-plane surface alongside the existing
# `_grid_cells` skeleton the ANSI parser already consumes
# (src/grid.pdx, #3), keysym->byte LUT + stub-pty ring
# (src/keyboard.pdx, #4), and a 256-row scrollback ring
# (src/scrollback.pdx, #5). None of these wire into Main::pdxterm_main
# or src/ansi.pdx yet -- see each new file's header for the specific
# upstream blockage (libpdx-gfx surface mint, the process argv ABI,
# or "don't touch a CLOSED milestone's state machine without a build
# pass available").
#
# Wave BBB (issues #6, #11, #12, #15) adds src/pty_wire.pdx (M3-001,
# #6: KIND_PTY spawn request via sys_cap_invoke, honest kernel-gap
# disclosure -- see that file's header) plus its sys_cap_invoke
# wrapper in src/syscall.pdx, and tests/scrollback_smoke.pdx (M4-004,
# #11: 300-row push smoke against Scrollback's 256-slot ring). Issues
# #12 (M5-001 signed 1.0.0 release) and #15 (v1.1-C release closer)
# are retroactive documentation closes -- see CHANGELOG.md.

name        = pdxterm
version     = 1.3.0
kind        = tool
entry       = Main::pdxterm_main
output      = build-out/pdxterm
caps_decl   = caps.decl

sources:
  - src/tool_ident.pdx           # Wave F: PDX_TOOL_NAME/PDX_TOOL_VERSION externs
  - src/syscall.pdx              # sys_semantic_send (SC+ ID 115) + sys_cap_invoke (SC+ ID 4, #6) wrappers
  - src/grid.pdx                 # 80x25 cursor grid (M3 skeleton) + M2-001 (#3) put_char/clear/render_all cell planes
  - src/window.pdx               # M1-002 (#2): argv rows/cols + KIND_SURFACE request stub
  - src/keyboard.pdx             # M2-002 (#4): keysym->byte LUT + stub-pty ring
  - src/scrollback.pdx           # M2-003 (#5): 256-row scrollback ring
  - src/pty_wire.pdx             # M3-001 (#6): KIND_PTY spawn request + master/slave attach seams
  - src/ansi.pdx                 # M3-002 (#7): ANSI CSI/SGR/cursor-move state machine
  - src/schema.pdx               # v1.1-B (#14): TermEventRecord@0.1 emit
  - src/main.pdx                 # pdxterm_main entry

deps: []

tests:
  - tests/test_ansi.pdx                    # M3-002 (#7): parser fingerprint matrix
  - tests/render_identity.pdx              # M4-001 (#8): 80x25 grid seed + digest fingerprint
  - tests/cursor_move.pdx                  # M4-003 (#10): ESC[5;10H hello fingerprint
  - tests/shell_echo_roundtrip.pdx         # M4-002 (#9): honest-blockage witness
  - tests/scrollback_smoke.pdx             # M4-004 (#11): 300-row push vs 256-slot ring fingerprint
  - tests/test_semantic_emit.pdx           # v1.1-B (#14): sysno-115 marshal fingerprint

compliance:
  - module-basename-pascal
  - no-test-mnemonic
  - cmp-imm32-only
  - r11-scratch
  - byte-load-zero-then-mov_b
  - sysv-push-pop-parity
