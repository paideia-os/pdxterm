// src/grid.pdx -- pdxterm Wave P (M2-001 substrate skeleton)
// Grid module: 80x25 text grid + cursor state.
//
// Scope
// -----
// Wave P lands the encoder-half skeleton of the terminal cell grid
// so that the M3-002 ANSI parser (src/ansi.pdx) and the M4 golden-
// fingerprint smokes have a stable target surface to write into.
// Live libpdx-gfx surface commit lives at R102.M2-001 (issue #3);
// this skeleton exposes ONLY the .bss cell array + cursor state +
// two write primitives (`grid_write_char`, `grid_set_cursor`) the
// parser and the smokes call.
//
// Cell layout: 4 bytes per cell (glyph:u8, fg:u8, bg:u8, flags:u8).
// Grid is 80 * 25 = 2000 cells = 8000 bytes. Cursor state is four
// u64 slots (row, col, fg, bg) so the ANSI parser can update them
// without byte-load-and-mask arithmetic.
//
// paideia-as compliance
// ---------------------
//   - Module Grid (PascalCase basename).
//   - No `test rN, rN`; every zero-check is `cmp reg, 0`.
//   - cmp imm <= 0x7FFFFFFF (all imm here are the grid dimensions
//     80, 25, and 4-byte cell stride constants).
//   - r11 is scratch (used for every rip-relative lea).
//   - Byte writes never require a byte read first; the parser writes
//     glyphs top-down so no read-modify-write is needed.
//   - Every function is a leaf (no push/pop parity).
//
// Wire discipline: `grid_write_char` and `grid_set_cursor` are the
// two seams the ANSI parser needs. The smokes read the .bss grid
// state back via a golden-fingerprint compare rather than a live
// framebuffer diff.

module Grid = structure {

  // Grid dimensions. Frozen per design/graphics/r102-user-plan.md
  // §2.6 (80 cols, 25 rows -- the standard VT100 shape).
  pub let GRID_COLS : u64 = 80
  pub let GRID_ROWS : u64 = 25
  pub let CELL_BYTES: u64 = 4

  // Default cursor palette indices (SGR 39/49 posture): fg=7 (white),
  // bg=0 (black). Matches the 8-color palette the ANSI parser decodes
  // at SGR reset (\e[0m) or at fresh-boot cursor state.
  pub let DEFAULT_FG: u64 = 7
  pub let DEFAULT_BG: u64 = 0

  // .bss cell grid: 80 * 25 * 4 = 8000 bytes. Interpreted per-cell
  // as (glyph:u8 @+0, fg:u8 @+1, bg:u8 @+2, flags:u8 @+3). The
  // parser's write path uses stride multiplication (row * 80 + col)
  // * 4 = byte offset. Every arithmetic factor fits imm32.
  pub let mut _grid_cells : [u8; 8000] = uninit @align(8)

  // .bss cursor state: four u64 slots (row, col, fg, bg). The ANSI
  // parser reads and writes these directly; smokes assert against
  // them for cursor-move correctness.
  pub let mut cursor_row : u64 = uninit @align(8)
  pub let mut cursor_col : u64 = uninit @align(8)
  pub let mut cursor_fg  : u64 = uninit @align(8)
  pub let mut cursor_bg  : u64 = uninit @align(8)

  // .bss observability: number of grid_write_char calls that landed
  // (clamped or in-bounds) since the last reset. Smokes read this to
  // confirm the parser stepped through the fixture stream.
  pub let mut grid_writes : u64 = uninit @align(8)

  // grid_reset() -- zero cell array, home cursor, reset palette.
  //
  // Called at every M4 smoke fixture entry so tests run against a
  // known-clean grid. Zero-fill is a bounded 8000-byte loop; small
  // enough to inline as a 1000-qword rep-store (paideia-as does not
  // emit rep instructions at this milestone, so we open-code an
  // 8-byte-at-a-time loop bounded by a cmp/jb pair). Cursor lands
  // at (0, 0) with default palette.
  pub let grid_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M2-001 grid_reset. Zero the 8000-byte cell array in 1000 u64-wide stores; home cursor to (0,0) with fg=7/bg=0 default palette; zero the grid_writes observability slot. Leaf; r11 scratch for rip-relative lea; rcx as loop counter (SysV caller-save). No `test`; loop uses `cmp rcx, 1000; jb`. All immediates (1000, 8, 7, 0) fit imm32. cursor_row/cursor_col/cursor_fg/cursor_bg touched via rip-relative store. No push/pop parity.",
      block: {
        // Zero-fill the cell array (1000 u64 stores).
        lea r11, [rip + _grid_cells];
        xor rcx, rcx;
        xor rax, rax;
      grid_reset_loop:
        mov [r11 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 1000;
        jb grid_reset_loop;

        // Home cursor + default palette.
        xor rax, rax;
        lea r11, [rip + cursor_row];    mov [r11], rax;
        lea r11, [rip + cursor_col];    mov [r11], rax;
        lea r11, [rip + cursor_bg];     mov [r11], rax;
        lea r11, [rip + grid_writes];   mov [r11], rax;
        mov rax, 7;
        lea r11, [rip + cursor_fg];     mov [r11], rax;
        ret
      }
    }

  // grid_set_cursor(row, col) -> u64
  //   Clamp row to [0, GRID_ROWS-1] and col to [0, GRID_COLS-1] then
  //   store into cursor_row / cursor_col. Returns 0 on in-bounds
  //   store, 1 on clamp (either coord was out of range).
  //   The ANSI parser's CSI-H handler is the sole caller at Wave P.
  pub let grid_set_cursor : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64) (col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M2-001 grid_set_cursor. Clamp (row, col) into grid bounds then store. rax reserved as return-value scratch (0 = in-bounds, 1 = clamp fired). r11 scratch for the two .bss stores. No `test`; two `cmp reg, imm` clamp gates against GRID_ROWS/GRID_COLS. All imm fit imm32 (25, 80). Leaf function; SYSCALL never issued. rdx used as the clamp-marker accumulator (SysV caller-save).",
      block: {
        xor rdx, rdx;                    // clamp_fired = 0
        // Clamp row.
        cmp rdi, 25;
        jb grid_set_cursor_row_ok;
        mov rdi, 24;                     // GRID_ROWS - 1
        mov rdx, 1;
      grid_set_cursor_row_ok:
        // Clamp col.
        cmp rsi, 80;
        jb grid_set_cursor_col_ok;
        mov rsi, 79;                     // GRID_COLS - 1
        mov rdx, 1;
      grid_set_cursor_col_ok:
        lea r11, [rip + cursor_row];     mov [r11], rdi;
        lea r11, [rip + cursor_col];     mov [r11], rsi;
        mov rax, rdx;
        ret
      }
    }

  // grid_write_char(glyph) -> u64
  //   Write `glyph` (low byte of rdi) at the current cursor cell,
  //   using the current cursor_fg / cursor_bg palette. Advance cursor
  //   one column; wrap to next row on col == GRID_COLS. Returns 0 on
  //   success, 1 if the cursor rolled off the bottom (row overflow;
  //   the write still lands at (GRID_ROWS-1, GRID_COLS-1) as a
  //   clamped emit).
  //
  // Byte offset into _grid_cells: (row * 80 + col) * 4. The multiply
  // by 80 avoids `imul r, imm` (pdx encoder pitfalls: 2-op imul
  // forbidden); we compute `row * 80 = row * 64 + row * 16 =
  // (row << 6) + (row << 4)` via shl + add. The final `* 4` is a
  // simple shl. Every immediate fits imm32.
  pub let grid_write_char : (u64) -> u64 !{mem} @{} =
    fn (glyph: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M2-001 grid_write_char. Compose byte offset into _grid_cells via shift-add (no 2-op imul, per pdx encoder pitfalls). rbx preserves glyph across the load-store shape (caller passes glyph in rdi; the address computation trashes rax/rcx/rdx). r12 caches the &_grid_cells base after cursor load so the offset add lands on a live pointer. Returns 0 on in-bounds land, 1 if the advance wrapped past the bottom row (write clamped to bottom-right). r11 scratch for cursor loads / stores. All imm fit imm32 (4, 6, 80, 25, 24, 79). 2-push prologue (rbx, r12) keeps rsp%16==0 at any nested call (none at this shape; kept for uniformity with siblings). No `test`; every gate is `cmp reg, imm`.",
      block: {
        push rbx;                        // rsp%16: 8 -> 0
        push r12;                        // rsp%16: 0 -> 8
        sub rsp, 8;                      // rsp%16: 8 -> 0

        mov rbx, rdi;                    // rbx = glyph (low byte)

        // Load cursor state.
        lea r11, [rip + cursor_row];
        mov rax, [r11];                  // rax = row
        lea r11, [rip + cursor_col];
        mov rcx, [r11];                  // rcx = col

        // Compose byte offset: (row * 80 + col) * 4.
        // row * 80 = (row << 6) + (row << 4).
        mov rdx, rax;
        shl rdx, 6;                      // rdx = row * 64
        shl rax, 4;                      // rax = row * 16
        add rax, rdx;                    // rax = row * 80
        add rax, rcx;                    // rax = row * 80 + col
        shl rax, 2;                      // rax = (row * 80 + col) * 4

        // Store glyph, fg, bg, flags into the cell. Compose the cell
        // base pointer once into r12, then advance by 1 across the
        // four sized-byte stores per paideia-as encoder discipline
        // (`mov_b [ptr], reg` with a plain base -- mkfs-pdxb precedent).
        lea r12, [rip + _grid_cells];
        add r12, rax;                    // r12 = &cell (base for four byte stores)
        mov_b [r12], rbx;                // glyph (low byte of rbx)
        add r12, 1;
        lea r11, [rip + cursor_fg];
        mov rdx, [r11];
        mov_b [r12], rdx;
        add r12, 1;
        lea r11, [rip + cursor_bg];
        mov rdx, [r11];
        mov_b [r12], rdx;
        add r12, 1;
        xor rdx, rdx;
        mov_b [r12], rdx;                // flags = 0 at Wave P

        // Bump grid_writes observability counter.
        lea r11, [rip + grid_writes];
        mov rdx, [r11];
        add rdx, 1;
        mov [r11], rdx;

        // Advance cursor: col + 1; on col == 80 wrap to next row.
        lea r11, [rip + cursor_col];
        mov rcx, [r11];
        add rcx, 1;
        cmp rcx, 80;
        jb grid_write_char_advance_ok;
        // Wrap.
        xor rcx, rcx;
        lea r11, [rip + cursor_row];
        mov rax, [r11];
        add rax, 1;
        cmp rax, 25;
        jb grid_write_char_row_ok;
        // Row overflow: clamp to last row and set return flag.
        mov rax, 24;
        lea r11, [rip + cursor_row];    mov [r11], rax;
        lea r11, [rip + cursor_col];    mov [r11], rcx;
        mov rax, 1;
        jmp grid_write_char_done;
      grid_write_char_row_ok:
        lea r11, [rip + cursor_row];    mov [r11], rax;
        lea r11, [rip + cursor_col];    mov [r11], rcx;
        xor rax, rax;
        jmp grid_write_char_done;
      grid_write_char_advance_ok:
        lea r11, [rip + cursor_col];    mov [r11], rcx;
        xor rax, rax;
      grid_write_char_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ===================================================================
  // Wave OO (R102.M2-001, issue #3) -- grid math + full-window redraw.
  //
  // The M3-002 ANSI parser (src/ansi.pdx, already CLOSED) and its
  // three M4 golden-fingerprint smokes (also CLOSED) consume the
  // 25-row/4-byte-cell `_grid_cells` surface above via grid_reset /
  // grid_set_cursor / grid_write_char. Issue #3 specifies a distinct
  // shape (24 rows, separate glyph/attr byte planes, an explicit
  // grid_put_char/grid_clear/grid_render_all API), so this landing
  // adds it as a SEPARATE surface (`_cell_char` / `_cell_attr`,
  // RENDER_ROWS=24 / RENDER_COLS=80) rather than reshaping
  // `_grid_cells` underneath the already-landed ANSI/smoke call
  // sites. Consolidating the two grid representations into one is
  // left as a follow-up once a build/debugger pass can confirm the
  // ANSI-parser fingerprints (TestAnsi, CursorMove, RenderIdentity,
  // ShellEchoRoundtrip) survive the merge.
  //
  // grid_render_all blits each cell through `pdxterm_glyph_blit`
  // (below): paideia-as 0.36 has no STB_WEAK linkage (see
  // tools/user/cat/src/schema_wire.pdx and
  // tools/user/libpdx-elevate/src/elevate_audit_sink.pdx for prior
  // art establishing this project's convention), so the "WEAK stub"
  // the issue calls for is, per that convention, an ordinary real
  // function with an inert body: it accepts the real (x, y, char)
  // shape and returns 0 without touching a framebuffer, since
  // libpdx-font is not linkable yet. When libpdx-font lands, only
  // this function's body changes.
  // ===================================================================

  pub let RENDER_ROWS      : u64 = 24
  pub let RENDER_COLS      : u64 = 80
  pub let RENDER_DEFAULT_ATTR : u64 = 0x07   // fg=7 (white) / bg=0 (black), matches DEFAULT_FG/DEFAULT_BG

  // .bss: 24 * 80 = 1920 bytes per plane. Kept as two separate byte
  // planes (rather than the interleaved 4-byte-cell shape above)
  // because the issue names them individually (`_cell_char`,
  // `_cell_attr`) as the M2-001 target surface.
  pub let mut _cell_char : [u8; 1920] = uninit @align(8)
  pub let mut _cell_attr : [u8; 1920] = uninit @align(8)

  pub let mut _grid_render_call_count : u64 = uninit @align(8)

  // grid_clear() -- zero both cell planes. 1920 = 240 * 8, so both
  // planes zero in 240 u64-wide stores each (same shape as
  // grid_reset's 1000-store loop over `_grid_cells`).
  pub let grid_clear : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M2-001 (issue #3) grid_clear. Zero _cell_char then _cell_attr, 240 u64-wide stores each (1920 / 8 = 240 exactly). Leaf; r11 scratch for rip-relative lea; rcx loop counter (caller-save). No `test`; loop gate is `cmp rcx, 240; jb`. All immediates (240, 8) fit imm32. No push/pop parity.",
      block: {
        lea r11, [rip + _cell_char];
        xor rcx, rcx;
        xor rax, rax;
      grid_clear_char_loop:
        mov [r11 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 240;
        jb grid_clear_char_loop;

        lea r11, [rip + _cell_attr];
        xor rcx, rcx;
      grid_clear_attr_loop:
        mov [r11 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 240;
        jb grid_clear_attr_loop;
        ret
      }
    }

  // grid_put_char(row, col, ch) -> u64
  //   Bounds-check (row, col) against RENDER_ROWS/RENDER_COLS; on
  //   success, store `ch`'s low byte into _cell_char[row*80+col] and
  //   RENDER_DEFAULT_ATTR into the matching _cell_attr slot. Returns
  //   0 on in-bounds write, 1 on out-of-bounds (no write).
  //   Three curried args (row, col, ch) -- within the 4-arg limit, so
  //   no packing is needed.
  pub let grid_put_char : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64) (col: u64) (ch: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M2-001 (issue #3) grid_put_char. Leaf: every register used (rax, rcx, rdx, r10, r11) is caller-save. Bounds gates are `cmp reg, imm; jae fail` (row >= 24, col >= 80). Offset = row*80+col composed via (row<<6)+(row<<4)+col to avoid 2-op imul. Byte stores via `mov_b [ptr+idx], reg`. All immediates fit imm32 (24, 80, 0x07, 6, 4). Labels prefixed gpc_.",
      block: {
        cmp rdi, 24;
        jae gpc_oob;
        cmp rsi, 80;
        jae gpc_oob;

        mov rax, rdi;
        mov rcx, rdi;
        shl rax, 6;                        // row * 64
        shl rcx, 4;                        // row * 16
        add rax, rcx;                      // row * 80
        add rax, rsi;                      // + col

        lea r10, [rip + _cell_char];
        mov_b [r10 + rax], rdx;            // rdx = ch (low byte)

        lea r10, [rip + _cell_attr];
        mov rcx, 0x07;                     // RENDER_DEFAULT_ATTR
        mov_b [r10 + rax], rcx;

        xor rax, rax;
        ret
      gpc_oob:
        mov rax, 1;
        ret
      }
    }

  // pdxterm_glyph_blit(x, y, ch) -> u64
  //   WEAK-in-spirit stub (see file-header note above): libpdx-font
  //   is not linkable at Wave OO, so this body is inert -- it
  //   accepts the real (x, y, ch) argument shape and returns 0
  //   without touching a framebuffer. When libpdx-font lands, only
  //   this function's body changes; grid_render_all's call site
  //   stays identical.
  pub let pdxterm_glyph_blit : (u64, u64, u64) -> u64 !{} @{} =
    fn (x: u64) (y: u64) (ch: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "pdxterm M2-001 (issue #3) pdxterm_glyph_blit. Inert WEAK-in-spirit stub per this project's established convention for STB_WEAK-shaped fallbacks (paideia-as 0.36 has no true weak-linkage; see tools/user/cat/src/schema_wire.pdx). Accepts (x, y, ch) unconditionally and returns 0 without any memory or register-file effect beyond rax, since libpdx-font is not linkable yet. Two-instruction leaf. Effects declared !{} (strictly narrower than grid_render_all's !{mem, sysreg}, which paideia-as accepts since a callee may declare a subset of what its caller allows).",
      block: {
        xor rax, rax;
        ret
      }
    }

  // grid_render_all() -- full-window redraw. Walks all 24*80 cells
  // and blits each glyph via pdxterm_glyph_blit(x, y, ch), with
  // pixel position x = col*8 (CELL_WIDTH_PX), y = row*16
  // (CELL_HEIGHT_PX) -- matching Window::CELL_WIDTH_PX/CELL_HEIGHT_PX
  // in src/window.pdx.
  pub let grid_render_all : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pdxterm M2-001 (issue #3) grid_render_all. 3-push prologue (rbx = row, r12 = col, r13 = cell offset) keeps rsp%16 == 0 at the nested pdxterm_glyph_blit call, mirroring RenderIdentity::seed_pattern's identical 3-push shape. Cell offset composed via shift-add (row<<6)+(row<<4)+col, no 2-op imul. Pixel x/y computed via `shl` (col*8, row*16) -- both power-of-2 scales. Byte load via `xor rdx,rdx; mov_b rdx,[ptr+r13]`. All immediates fit imm32 (24, 80, 6, 4, 3). Labels prefixed gra_.",
      block: {
        push rbx;                          // rsp%16: 8 -> 0
        push r12;                          // rsp%16: 0 -> 8
        push r13;                          // rsp%16: 8 -> 0

        xor rbx, rbx;                      // rbx = row
      gra_row_loop:
        cmp rbx, 24;
        jae gra_done;
        xor r12, r12;                      // r12 = col
      gra_col_loop:
        cmp r12, 80;
        jae gra_row_next;

        // Cell offset = row*80 + col.
        mov rax, rbx;
        mov rcx, rbx;
        shl rax, 6;
        shl rcx, 4;
        add rax, rcx;
        add rax, r12;
        mov r13, rax;                      // r13 = cell offset

        lea r10, [rip + _cell_char];
        xor rdx, rdx;
        mov_b rdx, [r10 + r13];            // rdx = glyph byte

        mov rdi, r12;
        shl rdi, 3;                        // x = col * 8
        mov rsi, rbx;
        shl rsi, 4;                        // y = row * 16
        call pdxterm_glyph_blit;           // rdx already holds ch from the load above

        add r12, 1;
        jmp gra_col_loop;
      gra_row_next:
        add rbx, 1;
        jmp gra_row_loop;
      gra_done:
        lea r11, [rip + _grid_render_call_count];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
