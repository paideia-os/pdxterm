// src/schema.pdx -- pdxterm v1.1-B (issue #14)
// Schema module: TermEventRecord@0.1 marshal + sysno-115 emit.
//
// Scope
// -----
// Wave P v1.1-B lands the semantic-pipe emission wire for pdxterm.
// Every terminal event -- a printable byte, a cursor move, a
// palette change -- is folded into a TermEventRecord@0.1 the tool
// marshals and hands to sys_semantic_send (SC+ ID 115). Downstream
// subscribers (a future libpdx-semantic-pipe consumer ring) receive
// the record via the fixed 16-slot global _semantic_ring the kernel
// side maintains.
//
// Wave P discipline: emission is OPT-IN via a caller call site --
// term_event_emit(kind, arg0, arg1) marshals and dispatches. The
// per-byte hot path in the ANSI parser does NOT auto-emit at this
// milestone; the semantic-pipe consumer ring is not yet mature
// enough to absorb 8kHz keystroke traffic without back-pressure.
// A callsite in Main::pdxterm_main (or a future TUI compositor)
// batches events and emits at frame boundaries. The Wave P landing
// gives the shape; the batching policy lands with the shell attach
// at R102.M3-001 (issue #6).
//
// TermEventRecord@0.1 layout (48 bytes, @align(8), fits inside the
// sysno-115 240-byte per-slot cap with 192 bytes of headroom):
//
//   [ +0]  magic         [u8; 8] -- "PDXKTERM" ASCII LE (u64 0x4D5245544B584450)
//   [ +8]  version:u32   -- TERM_REC_VERSION = 1
//   [+12]  flags:u32     -- reserved (0 at v1.1-B)
//   [+16]  kind:u32      -- event kind (see TERM_EV_* constants below)
//   [+20]  reserved:u32  -- padding
//   [+24]  arg0:u64      -- kind-dependent payload lane 0
//   [+32]  arg1:u64      -- kind-dependent payload lane 1
//   [+40]  ts_tsc:u64    -- rdtsc snapshot at emit time
//
// Event kinds (frozen at v1.1-B):
//   TERM_EV_WRITE  = 1  -- arg0 = glyph, arg1 = (row << 32) | col
//   TERM_EV_CURSOR = 2  -- arg0 = row,   arg1 = col
//   TERM_EV_SGR    = 3  -- arg0 = fg,    arg1 = bg
//   TERM_EV_UNKNOWN = 4 -- arg0 = final_byte, arg1 = 0
//
// Schema fingerprint slot in the v1.1 namespace band (0xE0xy per
// tool convention). pdxterm's assigned slot: 0xE003 (band 0xE0**;
// pdxsock owns 0xE000..0xE00F for SockSessionRecord@0.x, pdxterm
// slots in at 0xE003 -- see design/graphics/r102-user-plan.md
// §"v1.1 schema allocation" for the band-manager entry the doc
// will carry). The 8-byte schema tag is the leading four u16 lanes
// of a BLAKE3 truncation over the canonical schema definition,
// swapped to real bytes at v1.2. At Wave P the schema tag is a
// printable magic so grep-friendly consumers can identify the
// record family before the registry lookup lands.
//
// paideia-as compliance
// ---------------------
//   - Module Schema (PascalCase basename).
//   - No `test rN, rN`; every zero-check via cmp reg, 0.
//   - cmp reg, imm <= 0x7FFFFFFF (largest imm is 48, the record byte count).
//   - r11 scratch for every rip-relative lea.
//   - No byte reads (record is composed via u64 stores).
//   - schema_emit prologue: 3-push (rbx, r12, r13) keeps rsp%16 == 0
//     at the nested sys_semantic_send call.

module Schema = structure {

  // ---- Wire constants ---------------------------------------------------

  // Schema tag published on the semantic-pipe wire. "PDXKTERM" ASCII
  // little-endian as a u64: bytes P D X K T E R M -> 0x4D5245544B584450.
  pub let TERM_SCHEMA_TAG : u64 = 0x4D5245544B584450

  // Magic at record[+0] -- same bytes as the schema tag so a raw-byte
  // consumer can identify the record family without an out-of-band tag.
  pub let TERM_REC_MAGIC : u64 = 0x4D5245544B584450

  // Version + flags packed as one u64 store at record[+8]. Version = 1
  // in bits [0..31]; flags = 0 in bits [32..63].
  pub let TERM_VERSION_AND_FLAGS : u64 = 1

  // Record length (48 bytes). Fits comfortably in the [1, 240]
  // sysno-115 per-slot cap.
  pub let TERM_REC_BYTES : u64 = 48

  // Event kind constants.
  pub let TERM_EV_WRITE   : u64 = 1
  pub let TERM_EV_CURSOR  : u64 = 2
  pub let TERM_EV_SGR     : u64 = 3
  pub let TERM_EV_UNKNOWN : u64 = 4

  // ---- .bss composition buffer + observability -------------------------

  // 48-byte composition buffer; one-in-flight-per-process discipline.
  pub let mut _term_record_buf     : [u8; 48] = uninit @align(8)

  // Emission counters (visible to fingerprint smokes + future audit-wire).
  pub let mut term_emit_ok_count   : u64 = uninit @align(8)
  pub let mut term_emit_err_count  : u64 = uninit @align(8)
  pub let mut term_last_kind       : u64 = uninit @align(8)

  // ---- Reset + emit primitives -----------------------------------------

  pub let schema_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm v1.1-B schema_reset. Zero the three observability slots. Composition buffer _term_record_buf is not scrubbed (term_event_emit overwrites all 6 lanes on every call). r11 scratch for rip-relative lea. Leaf; no push/pop parity.",
      block: {
        xor rax, rax;
        lea r11, [rip + term_emit_ok_count];     mov [r11], rax;
        lea r11, [rip + term_emit_err_count];    mov [r11], rax;
        lea r11, [rip + term_last_kind];         mov [r11], rax;
        ret
      }
    }

  // term_event_emit(kind, arg0, arg1) -> u64
  //   Marshal TermEventRecord@0.1 into _term_record_buf and dispatch
  //   via sys_semantic_send(TERM_SCHEMA_TAG, &_term_record_buf, 48).
  //   Returns the sysno-115 return value verbatim (0 on success,
  //   -EFAULT / -EINVAL on kernel-side refusal). Bumps
  //   term_emit_ok_count on success, term_emit_err_count on refusal;
  //   stashes kind into term_last_kind unconditionally so consumers
  //   walking .bss see the last-observed event even on refusal.
  //
  // Register plan:
  //   rbx = kind   (preserved across the marshal + syscall)
  //   r12 = arg0   (preserved)
  //   r13 = arg1   (preserved)
  //   r10 = &_term_record_buf (staged inside the marshal block)
  //   rax, rdx = rdtsc destinations then syscall return
  //   r11 = lea scratch
  //   rdi, rsi, rdx = sys_semantic_send args
  pub let term_event_emit : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (kind: u64) (arg0: u64) (arg1: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "pdxterm v1.1-B (issue #14) term_event_emit. Marshal a 48-byte TermEventRecord@0.1 into _term_record_buf then call Syscall::sys_semantic_send(TERM_SCHEMA_TAG, &_term_record_buf, 48). 3-push prologue (rbx=kind, r12=arg0, r13=arg1) = 24 bytes; entry rsp%16 == 8 -> post-push rsp%16 == 0 for the nested sys_semantic_send call. rbx/r12/r13 are SysV callee-save and survive the marshal + syscall. rax and rdx serve as rdtsc destinations (rdtsc: EDX:EAX = TSC); reconstruction via shl rdx, 32; or rax, rdx (proven at pdxsock main.pdx line 1794). No 2-op imul. All imm fit imm32 (48, 32, 4). No `test`; every zero-check is cmp rax, 0. Effect/cap tail matches Syscall::sys_semantic_send byte-for-byte (!{mem, sysreg} @{}). Labels prefixed schema_.",
      block: {
        push rbx;                                  // rsp%16: 8 -> 0
        push r12;                                  // rsp%16: 0 -> 8
        push r13;                                  // rsp%16: 8 -> 0

        mov rbx, rdi;                              // rbx = kind
        mov r12, rsi;                              // r12 = arg0
        mov r13, rdx;                              // r13 = arg1

        // Cache last_kind unconditionally (pre-syscall, visible even
        // on -EFAULT).
        lea r11, [rip + term_last_kind];
        mov [r11], rbx;

        // ---- Marshal the 48-byte record. ----
        lea r10, [rip + _term_record_buf];

        // magic @ +0.
        mov r11, 0x4D5245544B584450;               // "PDXKTERM" LE
        mov [r10 + 0], r11;

        // version:u32 | flags:u32 packed at +8 (version=1, flags=0).
        mov r11, 1;
        mov [r10 + 8], r11;

        // kind:u32 @ +16 (upper 32 bits from rbx are silently truncated).
        mov [r10 + 16], rbx;

        // arg0:u64 @ +24, arg1:u64 @ +32.
        mov [r10 + 24], r12;
        mov [r10 + 32], r13;

        // ts_tsc @ +40 via rdtsc reconstruction.
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        mov [r10 + 40], rax;

        // ---- sys_semantic_send(TERM_SCHEMA_TAG, &_term_record_buf, 48). ----
        mov rdi, 0x4D5245544B584450;               // schema tag = TERM_SCHEMA_TAG
        lea rsi, [rip + _term_record_buf];
        mov rdx, 48;                               // TERM_REC_BYTES
        call sys_semantic_send;

        // Bump ok / err counter based on rc.
        cmp rax, 0;
        jne schema_emit_err;
        lea r11, [rip + term_emit_ok_count];
        mov rdx, [r11];
        add rdx, 1;
        mov [r11], rdx;
        jmp schema_emit_done;
      schema_emit_err:
        lea r11, [rip + term_emit_err_count];
        mov rdx, [r11];
        add rdx, 1;
        mov [r11], rdx;
      schema_emit_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
