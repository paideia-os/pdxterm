// src/pty_wire.pdx -- pdxterm R102.M3-001 (issue #6)
// PtyWire module: KIND_PTY spawn request + shell attach seams.
//
// Scope
// -----
// Per design/graphics/r102-user-plan.md R102.M3-001: mint KIND_PTY
// (§7.2.3), spawn /bin/shell as a child with argv[0]="sh", attach the
// master end to pdxterm's keyboard input feed (Keyboard::_pty_out_ring,
// src/keyboard.pdx) and the slave end's output bytes into the grid
// render path (Ansi::ansi_feed_bytes, src/ansi.pdx).
//
// Kernel-gap disclosure
// ----------------------
// KIND_PTY has NO kernel-side substrate at Wave OO: there is no
// `kind_pty.pdx` dispatch body and no dedicated mint sysno (the
// highest landed dedicated sysno is 115, `sys_semantic_send`, per
// design/user/syscall-table.md; a dedicated `sys_pty_mint` would sit
// at the next contiguous FLOOR sysno, 116, following the "contiguous-
// with-last-allocated-sysno" dispatch discipline that same doc names
// for sysnos 104-115). §7.2.3 frames KIND_PTY's ops (mint, write,
// read, revoke) in the generic cap-invoke shape several other cap
// kinds already use without a new sysno (e.g. `KIND_PDXFS_FILE`'s
// `PFF_OP_READ_BYTES`, design/user/syscall-table.md's #2109 note) --
// this file takes THAT route: it dispatches through the already-
// landed generic `sys_cap_invoke` (SC+ ID 4, src/user/syscall_shim.pdx
// row 5; wrapped locally as `Syscall::sys_cap_invoke` in
// src/syscall.pdx) against a reserved candidate cap slot
// (PTY_CAP_SLOT_HINT) with a PROPOSED op encoding (PTY_OP_SPAWN = 1)
// that has no kernel-side handler yet. The call is expected to come
// back a negative errno (most likely `-EBADF`, since no mint has ever
// populated that cap-table slot) until R101 lands a real KIND_PTY
// dispatch body -- this is a genuine, disclosed kernel gap, not a
// simulated one; per the R102 plan's own §7.3 escalation posture
// ("file an issue against paideia-os/paideia-os under the R101
// milestone, push a stub in R102 that fails closed, and resume"),
// the fail-closed stub is what this file provides. `pty_spawn_shell`
// always records the raw syscall result + a blockage marker
// (PTY_BLOCKED_KERNEL_GAP = 0x8003, next in the per-repo blockage-code
// sequence after Window's 0x8002) rather than fabricating a live
// master/slave fd pair.
//
// Attach seams (wired now, fed for real once R101 lands KIND_PTY)
// -----------------------------------------------------------------
//   - `pty_drain_keyboard_to_master()` is the master-fd attach point:
//     it reads Keyboard::_pty_out_head (src/keyboard.pdx) -- the
//     count of translated keystroke bytes waiting in
//     Keyboard::_pty_out_ring -- and stages that count into
//     _pty_master_bytes_pending. Once a live master fd exists, this
//     function's body becomes a `sys_write(_pty_master_fd,
//     &_pty_out_ring[0], head)` call; the call site here is already
//     the keyboard-input-feed seam the issue asks for.
//   - `pty_feed_slave_bytes(ptr, len)` is the slave-fd attach point:
//     it forwards directly to `Ansi::ansi_feed_bytes(ptr, len)`
//     (src/ansi.pdx), which is the live grid-render path the three
//     already-CLOSED M3/M4 fingerprint tests exercise. Once a live
//     slave fd exists, its `sys_read` result buffer is handed to this
//     same function unchanged.
//
// argv[0]="sh": staged as a `.rodata` NUL-terminated fixture
// (PROC_ARGV0_SH) for the eventual real spawn (sys_execve + sys_dup2
// per the plan doc's M3-001 scope line -- both sysnos already exist
// in the kernel tree, src/kernel/core/syscall/handlers/sys_execve.pdx
// and sys_dup2.pdx); not issued yet since it is gated on a live slave
// fd from a successful KIND_PTY mint.
//
// paideia-as compliance
// ---------------------
//   - Module PtyWire (PascalCase basename).
//   - No `test rN, rN`; every zero-check is `cmp reg, 0`.
//   - No 2-op `imul` (no multiplication needed in this file).
//   - No `and r8..r15, imm64`.
//   - Byte literal ("sh\0") stored as a 3-byte `.rodata` array.
//   - r11 scratch for every rip-relative lea; r10 for a second base
//     pointer where two rip-relative addresses are live at once.
//   - pty_reset, pty_drain_keyboard_to_master and pty_feed_slave_bytes
//     are leaves; pty_spawn_shell issues one nested call
//     (sys_cap_invoke) and needs no push/pop since it touches no
//     callee-saved register across that call.
//   - Labels prefixed `pty_`.

module PtyWire = structure {

  // Reserved candidate cap-table slot pdxterm requests the loader (or
  // a future KIND_PTY mint path) populate. Arbitrary until R101
  // defines a real allocation convention for pty pairs; chosen above
  // the highest reserved-slot precedent this tree has seen documented
  // (design/user/syscall-table.md cites transient KIND_MEMORY parents
  // at slots 132/134 for volume/framebuffer mint staging).
  pub let PTY_CAP_SLOT_HINT : u64 = 136

  // PROPOSED op encoding for KIND_PTY's cap-invoke dispatch (§7.2.3
  // names mint/write/read/revoke; PTY_OP_SPAWN folds "mint a pair +
  // spawn /bin/sh onto the slave end" into a single op since that is
  // the only operation pdxterm's M3-001 scope needs). No kernel-side
  // dispatch entry exists for this op yet -- see file header.
  pub let PTY_OP_SPAWN : u64 = 1

  // Blockage marker convention: matches Window::SURFACE_BLOCKED_GFX_LINK
  // (0x8002, src/window.pdx) and ShellEchoRoundtrip's 0x8001
  // (tests/shell_echo_roundtrip.pdx). Next in sequence for this repo.
  pub let PTY_BLOCKED_KERNEL_GAP : u64 = 0x8003

  pub let PROC_ARGV0_SH : [u8; 3] = "sh\0"

  pub let mut _pty_master_fd            : u64 = uninit @align(8)
  pub let mut _pty_slave_fd             : u64 = uninit @align(8)
  pub let mut _pty_spawn_result         : u64 = uninit @align(8)
  pub let mut _pty_blocked              : u64 = uninit @align(8)
  pub let mut _pty_master_bytes_pending : u64 = uninit @align(8)
  pub let mut _pty_slave_bytes_rendered : u64 = uninit @align(8)

  // pty_reset() -- home every .bss slot (fd fields to 0, meaning "no
  // live fd"; blockage/result/counters to 0).
  pub let pty_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M3-001 (issue #6) pty_reset. Zero all six .bss slots. Leaf; r11 scratch for every rip-relative store. No push/pop parity.",
      block: {
        xor rax, rax;
        lea r11, [rip + _pty_master_fd];            mov [r11], rax;
        lea r11, [rip + _pty_slave_fd];             mov [r11], rax;
        lea r11, [rip + _pty_spawn_result];         mov [r11], rax;
        lea r11, [rip + _pty_blocked];              mov [r11], rax;
        lea r11, [rip + _pty_master_bytes_pending]; mov [r11], rax;
        lea r11, [rip + _pty_slave_bytes_rendered]; mov [r11], rax;
        ret
      }
    }

  // pty_spawn_shell() -> u64
  //   Dispatches sys_cap_invoke(PTY_CAP_SLOT_HINT, PTY_OP_SPAWN) --
  //   see file header for why this is expected to fail closed at
  //   Wave OO (no kernel-side KIND_PTY substrate). Stores the raw
  //   result, sets the blockage marker on any non-zero (negative
  //   errno) return, and leaves _pty_master_fd/_pty_slave_fd at 0
  //   (no live fds). On a hypothetical future zero return (kernel
  //   gap closed), fds stay 0 here too -- the ABI for how a live
  //   mint+spawn returns the fd pair is not yet specified by R101, so
  //   this function does not guess at unpacking rax; that unpacking
  //   is the follow-up once R101's real return shape is documented.
  //   Always returns 0 (Wave OO: no error signalling to the caller
  //   beyond the .bss audit trail, matching
  //   Window::window_request_surface's convention).
  pub let pty_spawn_shell : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "pdxterm M3-001 (issue #6) pty_spawn_shell. Leaf across its one nested call: every register live before/after `call sys_cap_invoke` (rdi, rsi, rax) is SysV caller-save, so no push/pop is needed even though this issues a real syscall. rdi=PTY_CAP_SLOT_HINT, rsi=PTY_OP_SPAWN loaded immediately before the call (no other register traffic to preserve). Result checked via `cmp rax, 0; jne` (same idiom as Schema::term_event_emit's rc check, src/schema.pdx line 180) rather than a signed js/jl, since sys_cap_invoke's only defined success value is exactly 0 (any negative errno takes the blocked path). All immediates fit imm32 (136, 1, 0x8003). No `test`. Effect/capability tail !{mem, sysreg} @{cap} matches Syscall::sys_cap_invoke byte-for-byte plus the .bss stores this wrapper adds. Labels prefixed pty_.",
      block: {
        mov rdi, 136;                      // PTY_CAP_SLOT_HINT
        mov rsi, 1;                        // PTY_OP_SPAWN
        call sys_cap_invoke;

        lea r11, [rip + _pty_spawn_result];
        mov [r11], rax;

        cmp rax, 0;
        jne pty_spawn_blocked;

        // Hypothetical success: no live fd-unpack ABI documented by
        // R101 yet, so fds stay at whatever pty_reset last set (0).
        // No blockage marker set on this path.
        xor rax, rax;
        ret

      pty_spawn_blocked:
        mov rax, 0x8003;                   // PTY_BLOCKED_KERNEL_GAP
        lea r11, [rip + _pty_blocked];
        mov [r11], rax;
        xor rax, rax;
        ret
      }
    }

  // pty_drain_keyboard_to_master() -> u64
  //   Master-fd attach seam: reads the count of translated keystroke
  //   bytes waiting in Keyboard::_pty_out_ring (src/keyboard.pdx,
  //   already landed at M2-002/#4) via Keyboard::_pty_out_head, and
  //   stages that count into _pty_master_bytes_pending. Returns the
  //   staged count. Once a live master fd exists (R101 KIND_PTY),
  //   this body's final store becomes a
  //   `sys_write(_pty_master_fd, &_pty_out_ring[0], head)` call
  //   instead -- the read of Keyboard's ring head is already the
  //   correct seam.
  pub let pty_drain_keyboard_to_master : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M3-001 (issue #6) pty_drain_keyboard_to_master. Leaf; r11 scratch for both rip-relative accesses. Reads the existing Keyboard::_pty_out_head observability slot (src/keyboard.pdx) rather than re-deriving ring occupancy, so this seam stays correct if Keyboard's ring-fill policy ever changes. No `test`; no branch at all in this body. No push/pop parity.",
      block: {
        lea r11, [rip + _pty_out_head];
        mov rax, [r11];
        lea r11, [rip + _pty_master_bytes_pending];
        mov [r11], rax;
        ret
      }
    }

  // pty_feed_slave_bytes(ptr, len) -> ()
  //   Slave-fd attach seam: forwards (ptr, len) straight into
  //   Ansi::ansi_feed_bytes (src/ansi.pdx, already landed and
  //   exercised by three CLOSED-issue fingerprint tests), then bumps
  //   _pty_slave_bytes_rendered by len. In a live kernel, `ptr` is a
  //   buffer just filled by `sys_read(_pty_slave_fd, ptr, len)`; at
  //   Wave OO any caller (a future scripted-HID smoke, or a live read
  //   loop once R101 lands) can already exercise this exact call
  //   shape against the real ANSI parser + grid.
  pub let pty_feed_slave_bytes : (u64, u64) -> () !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "pdxterm M3-001 (issue #6) pty_feed_slave_bytes. 1-push (rbx = len) preserves len across the nested ansi_feed_bytes call, since rsi is caller-save and ansi_feed_bytes is free to clobber it; rdi/rsi already hold (ptr, len) in the exact order ansi_feed_bytes expects, so no arg shuffle is needed before the call. Entry rsp%16 == 8 -> post-push rsp%16 == 0 for the nested call. All arithmetic is a single `add`, immediate-free. No `test`, no branch. No internal labels needed beyond the function name.",
      block: {
        push rbx;                          // rsp%16: 8 -> 0
        mov rbx, rsi;                      // rbx = len (rdi = ptr already positioned)
        call ansi_feed_bytes;

        lea r11, [rip + _pty_slave_bytes_rendered];
        mov rax, [r11];
        add rax, rbx;
        mov [r11], rax;

        pop rbx;
        ret
      }
    }

}
